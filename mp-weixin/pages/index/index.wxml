<view class="phone">
  <image class="bg-img" src="/assets/bg-zen.webp" mode="aspectFill" />
  <view class="veil"></view>

  <view class="topbar" style="padding-top: {{statusPad}}px;">
    <view class="brand">
      <text class="brand-title">电子木鱼</text>
      <text class="brand-sub">静心小玩具 · 原创</text>
    </view>
    <view class="merit-pill merit-pill-tap" bindtap="openStats">
      <view class="merit-pill-main">
        <text class="merit-label">今日</text>
        <text class="merit-num">{{todayMerit}}</text>
      </view>
      <text class="merit-sub">总 {{total}}</text>
    </view>
  </view>

  <view class="stage">
    <view class="side-rail">
      <view class="rail-item" bindtap="openStats">
        <image class="rail-ico" src="/assets/ui/rail-data.webp" mode="aspectFit" />
        <text class="rail-label">数据</text>
      </view>
      <view class="rail-item" bindtap="onRailResetSession">
        <image class="rail-ico" src="/assets/ui/rail-reset.webp" mode="aspectFit" />
        <text class="rail-label">重置</text>
      </view>
      <view class="rail-item {{autoOn || slowAutoOn ? 'active' : ''}}" bindtap="onRailAuto">
        <image class="rail-ico" src="/assets/ui/rail-auto.webp" mode="aspectFit" />
        <text class="rail-label">自动</text>
      </view>
    </view>
    <text class="hint">{{hint}}</text>
    <view class="float-layer">
      <text wx:for="{{floats}}" wx:key="id" class="float-txt" style="left: {{item.left}}%; top: {{item.top}}%;">{{item.text}}</text>
    </view>

    <view wx:if="{{mode === 'muyu'}}" class="tap-area" bindtap="onTapMuyu">
      <view class="instrument stage-muyu premium">
        <image class="muyu-ground-img {{bodyHit ? 'hit' : ''}}" src="{{muyuGround}}" mode="aspectFit" />
        <view class="muyu-ground-shadow {{bodyHit ? 'hit' : ''}}"></view>
        <view class="instrument-body {{bodyHit ? 'hit' : ''}}">
          <image class="prop-img muyu-layer muyu-layer-body" src="{{muyuBody}}" mode="aspectFit" />
          <image class="prop-img muyu-layer muyu-layer-shade" src="{{muyuShade}}" mode="aspectFit" />
          <image class="prop-img muyu-layer muyu-layer-spec {{muyuFlash ? 'flash' : ''}}" src="{{muyuSpec}}" mode="aspectFit" />
          <image wx:if="{{muyuRim}}" class="prop-img muyu-layer muyu-layer-rim" src="{{muyuRim}}" mode="aspectFit" />
        </view>
        <view class="muyu-mallet {{muyuSwing ? 'swing' : ''}}">
          <image class="muyu-mallet-img" src="{{muyuMallet}}" mode="aspectFit" />
        </view>
        <view class="hit-flash flash-muyu flash-premium {{muyuFlash ? 'pop' : ''}}"></view>
      </view>
    </view>

    <view wx:elif="{{mode === 'beads'}}" class="tap-area beads-tap" catchtouchstart="onBeadStart" catchtouchmove="onBeadMove" catchtouchend="onBeadEnd" catchtouchcancel="onBeadEnd">
      <view class="bead-strand">
        <view class="bead-track {{beadDropping ? 'dropping' : ''}}" style="transform: translateY({{beadOffset}}px);">
          <image wx:for="{{beads}}" wx:key="id" class="bead" src="{{beadSrc}}" style="transform: rotate({{item.rotate}}deg);" mode="aspectFill" />
        </view>
      </view>
    </view>

    <view wx:else class="tap-area" bindtap="onTapBowl">
      <view class="instrument stage-bowl">
        <view class="instrument-body bowl-body {{bodyHit ? 'hit' : ''}}">
          <image class="prop-img" src="{{bowlBody}}" mode="aspectFit" />
        </view>
        <view class="bowl-mallet-wrap {{bowlSwing ? 'swing' : ''}}">
          <view class="bowl-mallet-flip-box {{bowlFlip ? 'mallet-flip' : ''}}">
            <image class="bowl-mallet-img" src="{{bowlMallet}}" mode="heightFix" style="height: 100%;" />
          </view>
        </view>
        <view class="ripple {{bowlRipple ? 'play' : ''}}"></view>
        <view class="hit-flash flash-bowl {{bowlFlash ? 'pop' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="toolbar">
    <button class="btn" bindtap="openSkin">{{modeName}}皮肤</button>
    <button class="btn {{slowAutoOn ? 'primary' : ''}}" bindtap="onToggleSlowAuto">自动敲</button>
    <button class="btn {{fastAutoOn ? 'primary' : ''}}" bindtap="onAdAuto">视频·快敲</button>
    <button class="btn" bindtap="onAdSkin">视频·皮肤</button>
  </view>
  <button class="invite-btn" open-type="share">邀请好友</button>
  <text class="status-line {{autoOn ? 'on' : ''}}">{{status}}</text>

  <view class="tabs">
    <view class="tab {{mode === 'muyu' ? 'active' : ''}}" data-tab="muyu" bindtap="setMode">
      <text class="ico">🪵</text>
      <text>木鱼</text>
    </view>
    <view class="tab {{mode === 'beads' ? 'active' : ''}}" data-tab="beads" bindtap="setMode">
      <text class="ico">📿</text>
      <text>念珠</text>
    </view>
    <view class="tab {{mode === 'bowl' ? 'active' : ''}}" data-tab="bowl" bindtap="setMode">
      <text class="ico">🔔</text>
      <text>颂钵</text>
    </view>
  </view>

  <view class="sheet {{skinShow ? 'show' : ''}}">
    <view class="sheet-mask" bindtap="closeSkin"></view>
    <view class="sheet-card" catchtap="noop">
      <text class="sheet-title">选择{{modeName}}皮肤</text>
      <block wx:for="{{skinGroups}}" wx:key="gid" wx:for-item="grp">
        <text wx:if="{{grp.label}}" class="skin-group-label">{{grp.label}}</text>
        <view class="skin-grid">
          <view wx:for="{{grp.items}}" wx:key="id" class="skin-opt {{item.id === currentSkin ? 'selected' : ''}} {{item.unlocked ? '' : 'locked'}}" data-id="{{item.id}}" bindtap="pickSkin">
            <view class="skin-swatch">
              <image src="{{item.thumb}}" mode="aspectFit" />
            </view>
            <text>{{item.name}}</text>
            <text wx:if="{{!item.unlocked}}" class="need-unlock">需解锁</text>
          </view>
        </view>
      </block>
      <button class="btn" bindtap="closeSkin">关闭</button>
    </view>
  </view>

</view>
