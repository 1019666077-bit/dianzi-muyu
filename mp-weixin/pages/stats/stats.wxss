page {
  height: 100%;
  background: #0d0a06;
  color: #f5e6c8;
}
.page {
  min-height: 100%;
  padding: 0 20px 32px;
  box-sizing: border-box;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20px;
}
.back {
  display: flex;
  align-items: center;
  color: #e8c56a;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 8px 0;
  min-width: 56px;
}
.back:active {
  opacity: 0.85;
}
.back-arrow {
  font-size: 22px;
  margin-right: 2px;
  line-height: 1;
  font-weight: 400;
}
.title {
  font-size: 16px;
  font-weight: 600;
  color: #e8c56a;
  letter-spacing: 0.08em;
}
.topbar-spacer {
  width: 56px;
}
.list {
  background: rgba(8, 6, 4, 0.62);
  border-radius: 14px;
  padding: 2px 16px;
  margin-bottom: 20px;
  border: 1px solid rgba(201, 162, 39, 0.35);
  box-shadow: inset 0 1px 0 rgba(255, 220, 150, 0.06);
}
.list-sub .row .value {
  font-size: 16px;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 0;
  border-bottom: 1px solid rgba(232, 197, 106, 0.12);
}
.row:last-child {
  border-bottom: none;
}
.label {
  font-size: 15px;
  color: rgba(245, 230, 200, 0.82);
}
.value {
  font-size: 18px;
  font-weight: 700;
  color: #e8c56a;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
}
.row-total .label {
  color: #f5e6c8;
  font-weight: 600;
}
.row-total .value {
  font-size: 20px;
  color: #e8c56a;
}
.streak-banner {
  margin: 0 0 14px;
  padding: 12px 16px;
  border-radius: 14px;
  background: rgba(8, 6, 4, 0.62);
  border: 1px solid rgba(201, 162, 39, 0.45);
  box-shadow: inset 0 1px 0 rgba(255, 220, 150, 0.08);
  text-align: center;
}
.streak-banner text {
  font-size: 15px;
  font-weight: 600;
  color: #e8c56a;
  letter-spacing: 0.08em;
}
.gap-hint {
  display: block;
  font-size: 12px;
  color: rgba(232, 197, 106, 0.72);
  letter-spacing: 0.04em;
  margin: -12px 0 18px 4px;
}
.scene-debug {
  margin-top: 4px;
}
.section-label {
  display: block;
  font-size: 11px;
  letter-spacing: 0.18em;
  color: rgba(245, 230, 200, 0.42);
  margin-bottom: 8px;
  padding-left: 4px;
}
.btn {
  width: 100%;
  margin: 10px 0 0;
  border: 1px solid rgba(201, 162, 39, 0.45);
  background: rgba(8, 6, 4, 0.55);
  color: #f5e6c8;
  border-radius: 12px;
  padding: 12px;
  font-size: 14px;
  line-height: 1.3;
}
.btn.danger {
  border-color: rgba(220, 100, 80, 0.45);
  background: rgba(120, 40, 30, 0.25);
  color: rgba(255, 200, 190, 0.95);
}
button.btn::after {
  border: none;
}
