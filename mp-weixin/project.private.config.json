      { "type": "suffix", "value": ".webp" }
    ],
    "include": [
      { "type": "folder", "value": "assets/skins" },
      { "type": "folder", "value": "assets/sfx" },
      { "type": "folder", "value": "assets/ui" },
      { "type": "file", "value": "assets/bg-zen.jpg" },
      { "type": "file", "value": "assets/share-cover.jpg" }
    ]
  },
  "setting": {
    "urlCheck": true,
    "compileHotReLoad": true,
    "ignoreUploadUnusedFiles": false,
    "ignoreDevUnusedFiles": false
  }
}
